# Shared
NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/custva

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# WhatsApp Cloud API
WA_PROVIDER=cloud_api
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=

# Monitoring
SENTRY_DSN=

# Web apps
CUSTVA_API_BASE_URL=http://localhost:4000/api/v1
CUSTVA_DEV_MERCHANT_ID=00000000-0000-0000-0000-000000000010
CUSTVA_PLATFORM_MERCHANT_ID=00000000-0000-0000-0000-000000000001
CUSTVA_PLATFORM_ADMIN_PASSWORD=Admin@123
