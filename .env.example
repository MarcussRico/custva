# Shared
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/custva

# Redis / Queue
REDIS_URL=redis://localhost:6379

# Auth (use long random secrets; production requires >= 32 chars)
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-secret-min-32-chars

# Comma-separated browser origins for merchant + admin apps (required in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Meta app secret — used to verify X-Hub-Signature-256 on webhooks (required in production)
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_MERCHANT_DAILY_CAP=500
WA_PLATFORM_DAILY_CAP=100000

# Web apps / local seed
CUSTVA_API_BASE_URL=http://localhost:4000/api/v1
# Local-only: enables x-dev-merchant-id bypass when NODE_ENV is not production. Never set in prod.
CUSTVA_DEV_MERCHANT_ID=00000000-0000-0000-0000-000000000010
CUSTVA_PLATFORM_MERCHANT_ID=00000000-0000-0000-0000-000000000001
# Required for db:seed — choose a strong password (Admin@123 refused when NODE_ENV=production)
ADMIN_EMAIL=admin@custva.local
ADMIN_PASSWORD=replace-with-strong-admin-password
CUSTVA_PLATFORM_ADMIN_PASSWORD=replace-with-strong-admin-password
