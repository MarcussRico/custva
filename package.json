{
  "name": "custva",
  "version": "0.1.0",
  "private": true,
  "description": "Custva monorepo for customer retention and WhatsApp engagement.",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  },
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "dev:web-merchant": "corepack pnpm --filter @custva/web-merchant dev",
    "dev:web-admin": "corepack pnpm --filter @custva/web-admin dev",
    "dev:api": "corepack pnpm --filter @custva/api dev",
    "dev:worker": "corepack pnpm --filter @custva/worker dev",
    "lint": "corepack pnpm -r lint",
    "format": "echo \"No formatters configured yet — see HANDOVER.md\"",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "build": "corepack pnpm -r build",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:seed-lifecycle": "node scripts/seed-lifecycle-templates.mjs"
  }
}
