# ── Custva Web Merchant — Local Environment ──────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# Backend API
CUSTVA_API_BASE_URL=http://localhost:4000/api/v1

# Local-only auth bypass for server components when no session cookie exists.
# Do NOT set this in Vercel / production.
CUSTVA_DEV_MERCHANT_ID=00000000-0000-0000-0000-000000000010

# ── OTP / Auth ────────────────────────────────────────────────────────────────
# Secret used to sign the OTP pending cookie JWT (required in production).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_JWT_SECRET=replace-with-a-32-char-random-hex-string

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────────
# Gmail example — use an App Password, NOT your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
