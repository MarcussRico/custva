# ── Custva Web Admin — Local Environment ─────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

CUSTVA_API_BASE_URL=http://localhost:4000/api/v1

# Local-only: enables x-dev-merchant-id + platform_admin role when no session.
# Do NOT set this in Vercel / production.
CUSTVA_DEV_MERCHANT_ID=00000000-0000-0000-0000-000000000010

# OTP cookie JWT secret (required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_OTP_JWT_SECRET=replace-with-a-32-char-random-hex-string

# SMTP for admin login OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
